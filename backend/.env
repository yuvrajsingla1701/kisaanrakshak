# ─────────────────────────────────────────────────────────────────────────────
# KisanRakshak Backend — Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (psycopg v3 driver)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/kisanrakshak

# Security
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_long_random_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — URL of the React frontend
# vite.config.js sets port 3000
FRONTEND_URL=http://localhost:3000

# API settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=KisanRakshak API
DEBUG=true
